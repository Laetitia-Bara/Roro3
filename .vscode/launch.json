{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Roro3 : lancer l'application",
      "type": "debugpy",
      "request": "launch",
      "module": "roro3",
      "args": ["ui"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Roro3 : test familial sur iPhone",
      "type": "debugpy",
      "request": "launch",
      "module": "roro3",
      "args": ["ui", "--family"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Roro3 : tests automatiques",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
