# Aucun compte ni token réel nécessaire : seul le simulateur est disponible.
RORO_CONNECTOR=simulated
RORO_DATABASE_PATH=data/roro3-demo.sqlite3
RORO_TIMEZONE=Europe/Paris
# Ces valeurs initialisent une NOUVELLE base. Ensuite utiliser l'interface/CLI.
RORO_OBSERVE=true
RORO_NOTIFY=false
RORO_RESERVE=false
RORO_DRY_RUN=true
